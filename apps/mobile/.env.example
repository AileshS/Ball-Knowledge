# Copy to apps/mobile/.env (gitignored) and fill in. Both values come from your
# Supabase dashboard: Project Settings > API (or "Connect").
# The anon/publishable key is designed to ship inside apps; row-level security
# protects the data. Never put the service_role / secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
